local function formatMoney(n)
	n = tonumber(n) or 0
	local neg = n < 0
	n = math.abs(n)
	local formatted
	if n >= 1e12 then
		formatted = string.format("%.2fT", n / 1e12)
	elseif n >= 1e9 then
		formatted = string.format("%.2fB", n / 1e9)
	elseif n >= 1e6 then
		formatted = string.format("%.2fM", n / 1e6)
	elseif n >= 1e3 then
		formatted = string.format("%.2fK", n / 1e3)
	else
		formatted = tostring(math.floor(n))
	end
	if neg then formatted = "-" .. formatted end
	return formatted
end

local function getMoney()
	if not Save then return 0 end
	local ok, data = pcall(function() return Save.Get() end)
	if ok and data and data.Money ~= nil then
		return tonumber(data.Money) or 0
	end
	return 0
end

