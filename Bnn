local oldNamecall; oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
	local method = getnamecallmethod()
	local args = {...}

	if scriptRunning and method == "InvokeServer" and self.Name == "RF/EggWorld/AskFieldEggCarry" then

		if isCarrying then
			return oldNamecall(self, unpack(args))
		end

		local result = oldNamecall(self, unpack(args))

		if result == true then
			if toggleStateV1 then
				isCarrying = true
				carryWalkActive = true
				carryWalkSpeed = Settings.MovementSpeed
				carrySpeedLocked = true

				do
					local hum = activeHumanoid or (player.Character and player.Character:FindFirstChildOfClass("Humanoid"))
					if hum then hum.WalkSpeed = carryWalkSpeed end
				end

				task.spawn(function()
					preciseWait(Settings.HookDelay)
					if toggleStateV1 and scriptRunning then
						local targetPos = Settings.BaseDropPosition
						if targetPos then
							local arrived = false
							local attempts = 0
							while scriptRunning and toggleStateV1 and not arrived and attempts < 20 do
								attempts = attempts + 1
								walkToTarget(targetPos, Settings.MovementSpeed, 3)
								repeat RunService.Heartbeat:Wait() until not isWalkingToTarget or not scriptRunning

								local char = player.Character
								local root = char and char:FindFirstChild("HumanoidRootPart")
								if root then
									arrived = (root.Position - targetPos).Magnitude <= 20
								end
							end

							if arrived and scriptRunning and toggleStateV1 then
								preciseWait(Settings.DropEggDelay)
								dropEggServer()
							end
						end
					end

					carrySpeedLocked = false
					carryWalkActive = false
					carryWalkSpeed = nil
					isCarrying = false
					applySpeedRealtime()
				end)
			end
		else
			if not isCarrying then
				isWalkingToTarget = false
				activeTargetSpeed = nil
				setMovementControlsEnabled(true)
			end
		end

		return result
	end

	return oldNamecall(self, ...)
end))

local function makePromptInstant(prompt)
	if prompt:IsA("ProximityPrompt") then
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 10)
		prompt.RequiresLineOfSight = false
	end
end

for _, descendant in pairs(workspace:GetDescendants()) do makePromptInstant(descendant) end
local promptConn = workspace.DescendantAdded:Connect(function(descendant)
	if scriptRunning and descendant:IsA("ProximityPrompt") then preciseWait(0.05); makePromptInstant(descendant) end
end)
table.insert(scriptConnections, promptConn)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if scriptRunning and not gameProcessed and input.KeyCode == Enum.KeyCode.Space then
