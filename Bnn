local EGG_PATTERN = "Egg spawned in"
local EGG_GROUP_WINDOW = 1.0

local mapByName = {}
for _, info in ipairs(Settings.MapLocations) do
	mapByName[info.Name] = info
end

local function stripRichText(text)
	return (tostring(text):gsub("<[^>]->", ""))
end

local function findMapFromChat(text)
	text = stripRichText(tostring(text))
	if not string.find(text, EGG_PATTERN, 1, true) then return nil end

	local lowerText = string.lower(text)

	local candidates = {}
	for name, info in pairs(mapByName) do
		table.insert(candidates, { name = name, info = info })
		if info.Aliases then
			for _, alias in ipairs(info.Aliases) do
				table.insert(candidates, { name = alias, info = info })
			end
		end
	end
	table.sort(candidates, function(a, b) return #a.name > #b.name end)

	for _, entry in ipairs(candidates) do
		local lowerName = string.lower(entry.name)
		local needle = " in " .. lowerName
		local startIdx, endIdx = string.find(lowerText, needle, 1, true)
		if startIdx then
			local nextChar = string.sub(lowerText, endIdx + 1, endIdx + 1)
			if nextChar == "" or not string.match(nextChar, "[a-z]") then
				return entry.info
			end
		end
	end
	return nil
end

local function findEggName(text)
	text = stripRichText(tostring(text))
	local s, e = string.find(text, "A ", 1, true)
	if s then
		local tail = string.sub(text, e + 1)
		local eggEnd = string.find(tail, " Egg spawned in", 1, true)
		if eggEnd then
			return string.sub(tail, 1, eggEnd - 1)
		end
	end
	local s2, e2 = string.find(text, "^x", 1)
	if s2 then
		local tail = string.sub(text, e2 + 1)
		local eggEnd = string.find(tail, " Egg spawned in", 1, true)
		if eggEnd then
			return "x" .. string.sub(tail, 1, eggEnd - 1)
		end
	end
	return "Unknown Egg"
end

local eggGroup = nil
local eggGroupToken = 0

local function resolveEggGroup(token)
	task.wait(EGG_GROUP_WINDOW)

	if token ~= eggGroupToken then return end
	if not eggGroup then return end

	local group = eggGroup
	eggGroup = nil

	if not autoEggEnabled or not scriptRunning then return end
	if isWalkingToTarget then return end

	local chosen = group.best
	if not chosen then return end

	local mapInfo = chosen.mapInfo
	local eggName = chosen.eggName

	print(string.format("[Auto Egg]: group winner = %s in %s — walking there!",
		eggName, mapInfo.Name))

	task.spawn(function()
		walkToTarget(mapInfo.Pos, Settings.TravelSpeed, 5)
	end)
end

local function handleEggSpawn(text)
	if not autoEggEnabled then return end
	if not scriptRunning then return end

	local mapInfo = findMapFromChat(text)
	if not mapInfo then
		if string.find(text, EGG_PATTERN, 1, true) then
			warn("[Auto Egg DEBUG] Unmatched raw: [" .. tostring(text) .. "]")
		end
		return
	end

	local eggName = findEggName(text)

	if not eggGroup then
		eggGroup = {
			best = { mapInfo = mapInfo, eggName = eggName },
		}
		eggGroupToken = eggGroupToken + 1
		local myToken = eggGroupToken
		task.spawn(function() resolveEggGroup(myToken) end)
	else
		if mapInfo.RequiredSpeed > eggGroup.best.mapInfo.RequiredSpeed then
			eggGroup.best = { mapInfo = mapInfo, eggName = eggName }
			print(string.format("[Auto Egg]: group upgrade → %s in %s",
				eggName, mapInfo.Name))
		else
			print(string.format("[Auto Egg]: group ignored %s in %s (lower tier)",
				eggName, mapInfo.Name))
		end
	end
end

local function hookChatMessage(message)
	if typeof(message) ~= "string" then return end
	handleEggSpawn(message)
end

